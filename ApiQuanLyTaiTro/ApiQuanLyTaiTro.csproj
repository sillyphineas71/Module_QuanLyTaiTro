<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Models\Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Template\**\*" />
    <Content Include="Assets\Template\**\*">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sinh file XML doc để Swagger đọc mô tả <summary> của controller/action -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Tắt cảnh báo XML doc (1591 thiếu comment, 1570/1572/1573 comment lệch param)
         – phần lớn đến từ file di sản Connection.cs / RequestLoggingMiddleware.cs -->
    <NoWarn>$(NoWarn);1591;1570;1572;1573</NoWarn>
  </PropertyGroup>

</Project>
