# ═══════════════════════════════════════════════════════════════════════════════════════════
# CẤU HÌNH FE — CỔNG VẬN ĐỘNG TÀI TRỢ
# ═══════════════════════════════════════════════════════════════════════════════════════════
# 🔴 CỔNG 8082 / API 5052 — CỐ Ý KHÁC cổng Cựu sinh viên (FE 8081, API 5042) để hai cổng chạy
# SONG SONG trên cùng một máy. Đổi số ở đây thì phải đổi cả:
#     · CorsWithOrigins trong ApiQuanLyTaiTro/appsettings.json
#     · applicationUrl trong ApiQuanLyTaiTro/Properties/launchSettings.json
#
# ⚠️ dotenv lấy giá trị CUỐI CÙNG khi một key xuất hiện nhiều lần. Repo gốc từng dính đúng bẫy
#    này (một REACT_APP_API_BASE_URL của trường khác nằm dưới và đè mất dòng đúng). Mỗi key một
#    lần duy nhất trong file này.
# ⚠️ ĐÃ BỎ toàn bộ biến OIDC/SSO của repo gốc: cổng này KHÔNG có luồng đăng nhập nào ở P1, và
#    đăng nhập P4 là email + mật khẩu trên TT_TaiKhoan, không qua SSO.
PORT=8082
REACT_APP_API_BASE_URL=http://localhost:5052/api

REACT_APP_SCHOOL_NAME=KHOA TOÁN - CƠ - TIN HỌC
REACT_APP_PARENT_ORG_NAME=TRƯỜNG ĐẠI HỌC KHOA HỌC TỰ NHIÊN
